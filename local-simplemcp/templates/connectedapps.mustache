{{!
    @template local_simplemcp/connectedapps

    A learner's own list of connected MCP clients, each with a revoke link.

    Context variables required for this template:
    * instructionsurl - Link to the "how to connect" page.
    * instructionslabel - Link text for that page.
    * emptymessage - Shown when the learner has no connected apps.
    * apps - Array of {name, meta, revokeurl, revokelabel}. Empty when none.

    Example context (json):
    {
        "instructionsurl": "https://moodle.example.com/local/simplemcp/oauth/instructions.php",
        "instructionslabel": "Need to connect a new app? See the instructions.",
        "emptymessage": "No apps are currently connected to your Example College account.",
        "apps": [
            {
                "name": "ChatGPT",
                "meta": "Connected: 1 March 2026 · Last used: 2 March 2026",
                "revokeurl": "https://moodle.example.com/local/simplemcp/oauth/manage.php?revoke=1&sesskey=abc",
                "revokelabel": "Revoke access"
            }
        ]
    }
}}
<div class="box generalbox local-simplemcp-connectedapps">
    <p><a href="{{instructionsurl}}">{{instructionslabel}}</a></p>

    {{^apps}}
        <p>{{emptymessage}}</p>
    {{/apps}}

    {{#apps}}
        <div class="card mb-2">
            <div class="card-body">
                <h5 class="card-title">{{name}}</h5>
                <p class="card-text">{{meta}}</p>
                <a href="{{revokeurl}}" class="btn btn-secondary btn-sm">{{revokelabel}}</a>
            </div>
        </div>
    {{/apps}}
</div>
